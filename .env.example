# Optional host path overrides for docker-compose.
# Copy to `.env` and adjust, or export these variables in your shell.

# Absolute path to the downloaded `processed_data` folder.
# PROCESSED_DATA_HOST=/abs/path/to/processed_data

# Absolute path to the downloaded `pretrained_models` folder.
# PRETRAINED_MODELS_HOST=/abs/path/to/pretrained_models

# Absolute path to `smpl_all_models` if it's not located under processed_data.
# This folder should include `smplx/` and `smplh_amass/`.
# SMPL_ALL_MODELS_HOST=/abs/path/to/smpl_all_models
